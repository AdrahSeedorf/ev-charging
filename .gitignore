# Build output
# Note the trailing glob: a bare `build/` would not match `build-ci/`, and any
# out-of-source build directory must be excluded, not just the conventional one.
build*/
out/
cmake-build-*/
_deps/
*.o
*.obj
*.a
*.exe

# IDE and editor state
.idea/
.vs/
*.iml
compile_commands.json

# VS Code: the shared workspace configuration IS committed, because a repo that
# builds and runs the moment it is opened is worth more than a tidy ignore file.
# Anything else VS Code drops in here is personal and stays out.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# OS noise
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# Test scratch files
tests/tmp_*

# Exports written by the CLI and the analysis tools
out/

# Cached Overpass and OSRM responses. Keep them locally -- they save the volunteer
# servers a request -- but they are fetched data, not source.
.cache/

# The committed maps are the SVGs, which GitHub renders inline in the README.
# The interactive HTML is regenerable and large, so it stays out.
docs/*.html
